<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style TargetType="Button" x:Key="Standart">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Width="{TemplateBinding Width}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Margin" Value="1.5"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonFont}"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBack}" />
        <Setter Property="FontSize" Value="11" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonTap}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style  TargetType="Button" x:Key="AddBtn" BasedOn="{StaticResource Standart}">
        <Setter Property="Content" Value="+"></Setter>
        <Setter Property="Background" Value="{DynamicResource ButtonHover}"/>
        <Setter Property="Width" Value="50"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Green" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonBack}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style  TargetType="Button" x:Key="DelBtn" BasedOn="{StaticResource Standart}">
        <Setter Property="Content" Value="🗑️"></Setter>
        <Setter Property="Background" Value="{DynamicResource ButtonTap}"/>
        <Setter Property="Width" Value="50"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonHoverDel}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonBack}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>