<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBack}"/>
        <Setter Property="Foreground" Value="{DynamicResource Font}"/>
    </Style>
    
    <Style TargetType="Page">
        <Setter Property="Background" Value="{DynamicResource WindowBack}"/>
        <Setter Property="Foreground" Value="{DynamicResource Font}"/>
    </Style>
    
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Font}"/>
        <Setter Property="Padding" Value="1"/>
    </Style>
    
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Font}"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource WindowBack}"/>
    </Style>
    
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource Font}"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource WindowBack}"/>
    </Style>
    
    <Style TargetType="DatePicker">
        <Setter Property="Foreground" Value="{DynamicResource Font}"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource WindowBack}"/>
    </Style>
    
    <Style TargetType="ListView">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource WindowBack}"/>
        <Setter Property="Foreground" Value="{DynamicResource Font}"/>
    </Style>
    
    <Style TargetType="StackPanel" x:Key="SP">
        <Setter Property="Background" Value="{DynamicResource WindowBack}"/>
        <Setter Property="Orientation" Value="Vertical"/>
    </Style>
    <Style TargetType="StackPanel" x:Key="SP_H" BasedOn="{StaticResource SP}">
        <Setter Property="Orientation" Value="Horizontal"/>
    </Style>
    
    <Style TargetType="WrapPanel" x:Key="WP">
        <Setter Property="Background" Value="{DynamicResource WindowBack}"/>
        <Setter Property="Orientation" Value="Vertical"/>
    </Style>
    <Style TargetType="WrapPanel" x:Key="WP_H" BasedOn="{StaticResource WP}">
        <Setter Property="Orientation" Value="Horizontal"/>
    </Style>
    
    <Style TargetType="Grid">
        <Setter Property="Background" Value="{DynamicResource WindowBack}"/>
    </Style>
</ResourceDictionary>