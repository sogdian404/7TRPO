<Page x:Class="_7_TRPO.Pages.Visit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_7_TRPO.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Visit">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <WrapPanel>
        <Button Content="Изменить информацию о пациенте" Click="EditPatientInfo_Click" Margin="5" HorizontalAlignment="Left"/>
        <TextBlock Text="История приемов:" Grid.Row="0" Margin="5"/>
        </WrapPanel>
        <ListView Grid.Row="1" ItemsSource="{Binding AppointmentStories}" Margin="10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Margin="2" Padding="5">
                        <WrapPanel Orientation="Vertical">
                            <TextBlock Text="Доктор:"/>
                            <TextBlock Text="{Binding doctor_id}" />
                            <TextBlock Text="Диагноз:"/>
                            <TextBlock Text="{Binding Diagnosis}" />
                            <DatePicker SelectedDate="{Binding date}"/>
                        </WrapPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Column="2" Grid.RowSpan="2" Background="White">
            <WrapPanel Orientation="Vertical">
            <TextBlock Padding="1" Text="Идентификатор:"/>
            <TextBlock Padding="1" Text="{Binding Id}"/>
        </WrapPanel>
        <WrapPanel Orientation="Vertical">
            <TextBlock Padding="1" Text="Фамилия:"/>
            <TextBlock Padding="1" Text="{Binding LastName}"/>
        </WrapPanel>
        <WrapPanel Orientation="Vertical">
            <TextBlock Padding="1" Text="Имя:"/>
            <TextBlock Padding="1" Text="{Binding Name}"/>
        </WrapPanel>
        <WrapPanel Orientation="Vertical">
            <TextBlock Padding="1" Text="Отчество:"/>
            <TextBlock Padding="1" Text="{Binding MiddleName}"/>
        </WrapPanel>
        <WrapPanel Orientation="Vertical">
            <TextBlock Padding="1" Text="День рождения:"/>
            <TextBlock Padding="1" Text="{Binding Birthday}"/>
        </WrapPanel>
        <WrapPanel Orientation="Vertical">
            <TextBlock Padding="1" Text="Последнее обращение:"/>
            <DatePicker Padding="1" Width="240" SelectedDate="{Binding LastVisit}"/>
        </WrapPanel>
        <WrapPanel Orientation="Vertical">
            <TextBlock Padding="1" Text="Последний доктор:"/>
            <TextBlock Padding="1" Text="{Binding LastDoctorName}"/>
        </WrapPanel>
        <WrapPanel Orientation="Vertical">
            <TextBlock Padding="1" Text="Диагноз:"/>
            <TextBox Width="240" Padding="1" Text="{Binding Diagnosis}"/>
        </WrapPanel>
        <WrapPanel Orientation="Vertical">
            <TextBlock Padding="1" Text="Рекомендации:"/>
            <TextBox Height="50" Width="240" Padding="1" Text="{Binding Recomendation}"/>
        </WrapPanel>
            <Button Margin="5" Width="200" HorizontalAlignment="Left" Content="Сохранить" Click="SaveNewData"/>
            <Button Margin="5" Width="200" HorizontalAlignment="Left" Content="Завершить прием пациента" Click="ResetPatient"/>
        </StackPanel>
    </Grid>
</Page>
