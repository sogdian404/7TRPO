<Page x:Class="_7_TRPO.Pages.Patient_Edit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_7_TRPO.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="250" d:DesignWidth="400"
      Title="Изменить пациента">

    <StackPanel>
        <TextBlock Text="Фамилия:"/>
        <TextBox Text="{Binding LastName}"/>
        <TextBlock Text="Имя:"/>
        <TextBox Text="{Binding Name}"/>
        <TextBlock Text="Отчество:"/>
        <TextBox Text="{Binding MiddleName}"/>
        <TextBlock Text="Телефон:"/>
        <TextBox Text="{Binding PhoneNumber}"/>
        <TextBlock Text="Дата рождения:"/>
        <DatePicker SelectedDate="{Binding Birthday}"/>
        <StackPanel Style="{StaticResource SP}">
            <Button Style="{StaticResource Standart}" Content="Сохранить" Click="Save_Click" />
            <Button Style="{StaticResource Standart}" Content="Отмена" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Page>
