<Page x:Class="_7_TRPO.Pages.D_registration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_7_TRPO.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="200"
      Title="Ргистрация">
    <Grid>
            <StackPanel Margin="5" x:Name="D_RegisterForm" Height="280" Width="180">
                <TextBlock Text="Фамилия:"/>
                <TextBox Text="{Binding LastName}"/>
                <TextBlock Text="Имя:"/>
                <TextBox  Text="{Binding Name}"/>
                <TextBlock Text="Отчество:"/>
                <TextBox  Text="{Binding MiddleName}"/>
                <TextBlock Text="Специальность:"/>
                <TextBox  Text="{Binding Specialisation}"/>
                <TextBlock Text="Пароль:"/>
                <TextBox  Text="{Binding Password}" x:Name="Pass1"/>
                <TextBlock Text="Подтвердите пароль:"/>
                <TextBox  Text="{Binding RepeatPassword}" x:Name="Pass2"/>
                <Button Content="Зарегистрировать" Margin="5" Click="NewDoctor"/>
            <Button Content="Отмена" Margin="5" Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Page>
