<Page x:Class="_7_TRPO.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_7_TRPO.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="хз как назвать">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <Button Margin="5" Padding="5" Click="CreatePatient_Click">Создать пациента</Button>
            <Button Margin="5" Padding="5" Click="StartVisit_Click">Начать прием</Button>
            <Button Margin="5" Padding="5" Click="EditInfo_Click">Изменить информацию</Button>
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{Binding P_List, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding SelectedPatient, UpdateSourceTrigger=PropertyChanged}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Margin="5" Orientation="Vertical">
                                <TextBlock Text="{Binding Id}"/>
                                <TextBlock Text="{Binding LastName}"/>
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding PhoneNumber}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        <WrapPanel Margin="5" Grid.Column="1" Grid.RowSpan="2" Orientation="Vertical" x:Name="D_current">
            <TextBlock Padding="1" Text="Идентификатор:"/>
            <TextBlock Padding="1" Text="{Binding Id}"/>
            <TextBlock Padding="1" Text="Фамилия:"/>
            <TextBlock Padding="1" Text="{Binding LastName}"/>
            <TextBlock Padding="1" Text="Имя:"/>
            <TextBlock Padding="1" Text="{Binding Name}"/>
            <TextBlock Padding="1" Text="Отчество:"/>
            <TextBlock Padding="1" Text="{Binding MiddleName}"/>
            <TextBlock Padding="1" Text="Специальность:"/>
            <TextBlock Padding="1" Text="{Binding Specialisation}"/>
        </WrapPanel>
    </Grid>
</Page>
