<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme colors updated per design spec -->

    <!-- Backgrounds -->
    <Color x:Key="AppBackgroundColor">#F5FAFB</Color>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>

    <Color x:Key="PanelBackgroundColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>

    <Color x:Key="InputBackgroundColor">#F0F6F8</Color>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>

    <!-- Text -->
    <Color x:Key="HeaderTextColor">#2E3B4E</Color>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="{StaticResource HeaderTextColor}"/>

    <Color x:Key="PrimaryTextColor">#444B54</Color>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>

    <Color x:Key="SecondaryTextColor">#6E7A89</Color>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>

    <!-- Actions -->
    <Color x:Key="PrimaryActionColor">#33B8B1</Color>
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="{StaticResource PrimaryActionColor}"/>

    <Color x:Key="DangerColor">#E65A4F</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

    <!-- Accent -->
    <Color x:Key="AccentColor">#3A9AD9</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

    <!-- Validation -->
    <Color x:Key="ValidationErrorBackgroundColor">#FFE8E8</Color>
    <SolidColorBrush x:Key="ValidationErrorBackgroundBrush" Color="{StaticResource ValidationErrorBackgroundColor}"/>

    <Color x:Key="ValidationErrorBorderColor">#D93025</Color>
    <SolidColorBrush x:Key="ValidationErrorBorderBrush" Color="{StaticResource ValidationErrorBorderColor}"/>

    <!-- Borders / separators -->
    <Color x:Key="BorderColor">#E7E7E8</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

    <!-- Map some common keys used in app styles to new brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonBackground" Color="{StaticResource PrimaryActionColor}"/>
    <SolidColorBrush x:Key="DangerButtonBackground" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="AccentBrushKey" Color="{StaticResource AccentColor}"/>

    <!-- Legacy keys preserved for existing styles -->
    <SolidColorBrush x:Key="WindowBack" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="Font" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="ButtonBack" Color="{StaticResource PrimaryActionColor}"/>
    <SolidColorBrush x:Key="ButtonHover" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ButtonTap" Color="#2D9CA7"/>
    <SolidColorBrush x:Key="ButtonHoverDel" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ButtonFont" Color="{StaticResource PanelBackgroundColor}"/>

</ResourceDictionary>