<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme colors updated per design spec -->

    <!-- Backgrounds -->
    <Color x:Key="AppBackgroundColor">#1E2A32</Color>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>

    <Color x:Key="PanelBackgroundColor">#2A3C46</Color>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>

    <Color x:Key="InputBackgroundColor">#324650</Color>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>

    <!-- Text -->
    <Color x:Key="HeaderTextColor">#D6F4FF</Color>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="{StaticResource HeaderTextColor}"/>

    <Color x:Key="PrimaryTextColor">#E4E8EB</Color>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>

    <Color x:Key="SecondaryTextColor">#A1B4BF</Color>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>

    <!-- Actions -->
    <Color x:Key="PrimaryActionColor">#33B8B1</Color>
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="{StaticResource PrimaryActionColor}"/>

    <Color x:Key="DangerColor">#E65A4F</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

    <!-- Accent -->
    <Color x:Key="AccentColor">#4FC3C7</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

    <!-- Validation -->
    <Color x:Key="ValidationErrorBackgroundColor">#3B1E1E</Color>
    <SolidColorBrush x:Key="ValidationErrorBackgroundBrush" Color="{StaticResource ValidationErrorBackgroundColor}"/>

    <Color x:Key="ValidationErrorTextColor">#FFB3B3</Color>
    <SolidColorBrush x:Key="ValidationErrorTextBrush" Color="{StaticResource ValidationErrorTextColor}"/>

    <!-- Borders / separators -->
    <Color x:Key="BorderColor">#3C4D55</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

    <!-- Map some common keys used in app styles to new brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonBackground" Color="{StaticResource PrimaryActionColor}"/>
    <SolidColorBrush x:Key="DangerButtonBackground" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="AccentBrushKey" Color="{StaticResource AccentColor}"/>

</ResourceDictionary>